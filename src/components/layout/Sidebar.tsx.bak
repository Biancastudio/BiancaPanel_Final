import type { FC } from 'react';
import { Link, useLocation } from 'wouter';
import { Home, ClipboardList, X, Users, LogOut } from 'lucide-react';
import { cn } from '@/lib/utils';
import { AnimatePresence, motion } from 'framer-motion';
import { useAuth } from '@/contexts/AuthContext';

interface SidebarProps {
  open: boolean;
  onClose: () => void;
}

export const Sidebar: FC<SidebarProps> = ({ open, onClose }) => {
  const [location] = useLocation();
  const { adminProfile, signOut } = useAuth();

  const navItems = [
    { name: 'Inicio', path: '/', icon: Home },
    { name: 'Inscripciones', path: '/inscripciones', icon: ClipboardList },
    ...(adminProfile?.role === 'superadmin'
      ? [{ name: 'Administradores', path: '/administradores', icon: Users }]
      : []),
  ];

  const sidebarContent = (
    <div className="flex flex-col h-full bg-sidebar border-r border-border/75 shadow-lg md:shadow-none w-64">
      <div className="p-6 flex items-center justify-between">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 rounded-full bg-gradient-to-br from-primary to-secondary flex items-center justify-center shadow-[0_0_15px_rgba(139,92,246,0.3)] overflow-hidden">
            <img src="/bs-logo.png" alt="Bianca Studio" className="w-full h-full object-contain mix-blend-screen" />
          </div>
          <div>
            <h1 className="text-white font-bold text-sm tracking-tight">Bianca Studio</h1>
            <p className="text-muted-foreground text-xs font-medium">Admin Panel</p>
          </div>
        </div>
        <button 
          onClick={onClose}
          className="md:hidden text-muted-foreground hover:text-white p-1 rounded-md hover:bg-white/5 transition-colors"
          data-testid="button-close-sidebar"
        >
          <X size={20} />
        </button>
      </div>

      <nav className="flex-1 px-3 py-4 space-y-1">
        {navItems.map((item) => {
          const isActive = location === item.path;
          return (
            <Link key={item.path} href={item.path}>
              <div
                data-testid={`link-sidebar-${item.name.toLowerCase()}`}
                className={cn(
                  "flex items-center gap-3 px-3 py-2.5 rounded-md cursor-pointer transition-all duration-150 ease-in-out relative group overflow-hidden",
                  isActive 
                    ? "text-white bg-primary/12 font-medium" 
                    : "text-muted-foreground hover:bg-primary/5 hover:text-white"
                )}
              >
                {isActive && (
                  <motion.div 
                    layoutId="active-indicator"
                    className="absolute left-0 top-0 bottom-0 w-1 bg-primary rounded-r-md" 
                    initial={false}
                  />
                )}
                <item.icon size={18} className={cn(
                  "transition-colors", 
                  isActive ? "text-primary" : "text-muted-foreground group-hover:text-primary/70"
                )} />
                <span className="text-sm">{item.name}</span>
              </div>
            </Link>
          );
        })}
      </nav>

      <div className="p-4 border-t border-border/50 space-y-3">
        {/* User info */}
        <div className="flex items-center gap-2.5">
          <div className="w-8 h-8 rounded-full bg-primary/20 border border-primary/30 flex items-center justify-center text-xs font-bold text-primary uppercase flex-shrink-0">
            {adminProfile?.name?.charAt(0) ?? '?'}
          </div>
          <div className="min-w-0">
            <p className="text-white text-xs font-medium truncate">{adminProfile?.name}</p>
            <p className="text-muted-foreground text-[10px] truncate capitalize">
  {adminProfile?.role === "superadmin" ? "CEO" : adminProfile?.role}
</p>
          </div>
        </div>
        {/* Logout button */}
        <button
          onClick={() => signOut()}
          data-testid="button-logout"
          className="w-full flex items-center gap-2 px-3 py-2 rounded-md text-muted-foreground hover:text-red-400 hover:bg-red-500/8 transition-all duration-150 text-xs group"
        >
          <LogOut size={14} className="group-hover:text-red-400 transition-colors" />
          <span>Cerrar sesión</span>
        </button>
        {/* Version badge */}
        <div className="flex items-center justify-between text-[10px] text-muted-foreground/50">
          <span>MagicLand IV</span>
          <span className="px-1.5 py-0.5 rounded-sm bg-white/5 border border-white/10">v1.0</span>
        </div>
      </div>
    </div>
  );

  return (
    <>
      {/* Mobile overlay backdrop */}
      <AnimatePresence>
        {open && (
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            onClick={onClose}
            className="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 md:hidden"
            data-testid="sidebar-backdrop"
          />
        )}
      </AnimatePresence>

      {/* Sidebar container */}
      <div 
        className={cn(
          "fixed top-0 bottom-0 left-0 z-50 transform transition-transform duration-300 ease-[cubic-bezier(0.2,0.8,0.2,1)] md:translate-x-0 h-full",
          open ? "translate-x-0" : "-translate-x-full"
        )}
      >
        {sidebarContent}
      </div>
    </>
  );
};
